<Card Href="@($"/snippet/{Snippet.Id}")" Title="@Snippet.Title" Description="@CardDescription">
    <TitleEnd>
        <button type="button"
                class="nf-icon-button @(Snippet.IsPinned ? "is-active" : null)"
                title="@(Snippet.IsPinned ? "Unpin" : "Pin")"
                @onclick="PinAsync">
            <Icon Name="@(Snippet.IsPinned ? "pin" : "pin-off")" />
        </button>
    </TitleEnd>
    <Meta>
        <span class="nf-badge @SnippetFormat.BadgeClass(Snippet.Language)">@Snippet.Language</span>
        <span>@SnippetFormat.Relative(Snippet.CreatedAt)</span>
    </Meta>
    <Actions>
        <a class="nf-link-button" href="@($"/snippet/{Snippet.Id}")">View</a>
        <button type="button" class="nf-link-button" @onclick="CopyAsync">Copy</button>
    </Actions>
</Card>
