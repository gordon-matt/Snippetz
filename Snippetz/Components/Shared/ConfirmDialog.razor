@if (visible)
{
    <div class="sz-modal-backdrop" @onclick="() => Close(false)">
        <div class="sz-modal" @onclick:stopPropagation="true">
            <h2>@title</h2>
            <p>@message</p>
            <div class="sz-modal-actions">
                <button type="button" class="sz-button" @onclick="() => Close(false)">Cancel</button>
                <button type="button" class="sz-button sz-button-danger" @onclick="() => Close(true)">Delete</button>
            </div>
        </div>
    </div>
}
