@page "/"
@page "/snippets"
@attribute [Authorize]

<PageTitle>@(searching ? "Search" : "Snippets") - Snippetz</PageTitle>

@if (loading)
{
    <p class="nf-muted">Loading.</p>
}
else if (loadError is not null)
{
    <EmptyState Icon="alert" Title="The snippets could not be read" Description="@loadError" />
}
else if (searching && results.Count == 0)
{
    <EmptyState Icon="search" Title="Nothing matches">
        <p>Try a shorter query, or drop the <span class="nf-mono">lang:</span> and <span class="nf-mono">tags:</span> filters.</p>
        <a class="nf-button" href="/">Clear search</a>
    </EmptyState>
}
else if (!searching && snippets.Count == 0)
{
    <EmptyState Icon="code" Title="You currently don't have any snippets">
        <p>Create your first one.</p>
        <a class="nf-button nf-button-primary" href="/editor"><Icon Name="plus" /> New snippet</a>
    </EmptyState>
}
else if (!searching && visible.Count == 0)
{
    <EmptyState Icon="search" Title="Nothing with that tag">
        <a href="/">Show all snippets</a>
    </EmptyState>
}
else
{
    <div class="nf-grid">
        @foreach (var snippet in (searching ? results : visible))
        {
            <SnippetCard Snippet="snippet" OnPin="TogglePinAsync" />
        }
    </div>
}
