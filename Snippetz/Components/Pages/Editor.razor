@page "/editor"
@page "/editor/{Id:int}"
@attribute [Authorize]

<PageTitle>@(isEdit ? "Edit snippet" : "New snippet") - Snippetz</PageTitle>

<PageHeader Title="@(isEdit ? "Edit snippet" : "Add new snippet")"
            Description="Tags are separated with a comma. The language is added as a tag automatically.">
    <Actions>
        @if (!loading && !missing)
        {
            <button type="submit" form="snippet-form" class="nf-button nf-button-primary" disabled="@saving">
                @(saving ? "Saving." : isEdit ? "Save changes" : "Create snippet")
            </button>
            <a class="nf-button" href="@(isEdit ? $"/snippet/{Id}" : "/")">Cancel</a>
        }
    </Actions>
</PageHeader>

@if (loading)
{
    <p class="nf-muted">Loading.</p>
}
else if (missing)
{
    <EmptyState Icon="alert" Title="That snippet isn't here">
        <a href="/">Back to your snippets</a>
    </EmptyState>
}
else
{
    <EditForm id="snippet-form" Model="form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="nf-validation">@error</p>
        }
        <div class="nf-field">
            <label for="title">Title</label>
            <InputText id="title" class="nf-input" @bind-Value="form.Title" placeholder="Recursively copy all files" />
            <ValidationMessage For="() => form.Title" class="nf-validation" />
        </div>
        <div class="nf-field">
            <label for="description">Description</label>
            <InputText id="description" class="nf-input" @bind-Value="form.Description" placeholder="What this snippet is for" />
        </div>
        <div class="nf-field">
            <label for="language">Language</label>
            <InputText id="language" class="nf-input" @bind-Value="form.Language" placeholder="python" list="languages" />
            <datalist id="languages">
                @foreach (string language in Constants.Languages)
                {
                    <option value="@language"></option>
                }
            </datalist>
            <ValidationMessage For="() => form.Language" class="nf-validation" />
        </div>
        <div class="nf-field">
            <label for="tags">Tags</label>
            <InputText id="tags" class="nf-input" @bind-Value="form.Tags" placeholder="automation, files, loop" />
            <span class="nf-hint">Comma-separated. The language tag is added for you.</span>
        </div>

        <div class="nf-field">
            <label for="code">Code</label>
            <InputTextArea id="code" class="nf-textarea nf-textarea-code" @bind-Value="form.Code" placeholder="cp -r ./src ./dest" />
            <ValidationMessage For="() => form.Code" class="nf-validation" />
        </div>
        <div class="nf-field">
            <label for="docs">Documentation</label>
            <InputTextArea id="docs" class="nf-textarea" @bind-Value="form.Docs" placeholder="Notes in Markdown" />
            <span class="nf-hint">Markdown. Shown under the code when the snippet is opened.</span>
        </div>
    </EditForm>
}
