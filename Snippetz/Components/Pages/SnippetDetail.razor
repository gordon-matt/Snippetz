@page "/snippet/{Id:int}"
@attribute [Authorize]

<PageTitle>@(snippet?.Title ?? "Snippet") - Snippetz</PageTitle>

@if (loading)
{
    <p class="nf-muted">Loading.</p>
}
else if (snippet is null)
{
    <EmptyState Icon="alert" Title="That snippet isn't here" Description="It may have been deleted, or it belongs to someone else.">
        <a class="nf-button" href="/">Back to your snippets</a>
    </EmptyState>
}
else
{
    <PageHeader Title="@snippet.Title"
                Description="@(string.IsNullOrWhiteSpace(snippet.Description) ? "No description" : snippet.Description)">
        <Actions>
            <button type="button" class="nf-icon-button @(snippet.IsPinned ? "is-active" : null)"
                    title="@(snippet.IsPinned ? "Unpin" : "Pin")" @onclick="TogglePinAsync">
                <Icon Name="@(snippet.IsPinned ? "pin" : "pin-off")" />
            </button>
        </Actions>
    </PageHeader>

    <div class="nf-split">
        <section class="nf-panel">
            <div class="nf-panel-header">
                <span class="nf-badge @SnippetFormat.BadgeClass(snippet.Language)">@snippet.Language</span>
                <button type="button" class="nf-link-button" @onclick="CopyCodeAsync">
                    <Icon Name="copy" /> Copy code
                </button>
            </div>
            <pre class="nf-code"><code class="language-@SnippetFormat.HighlightClass(snippet.Language)">@snippet.Code</code></pre>
        </section>

        <aside class="nf-panel">
            <div class="nf-panel-body">
                <div class="nf-chip-row">
                    @foreach (var tag in snippet.Tags)
                    {
                        <a class="nf-badge nf-badge-muted" href="@($"/?tag={Uri.EscapeDataString(tag)}")">@tag</a>
                    }
                </div>
                <ul class="nf-meta-list">
                    <li><span>Created</span><span>@SnippetFormat.Relative(snippet.CreatedAt)</span></li>
                    <li><span>Updated</span><span>@SnippetFormat.Relative(snippet.UpdatedAt)</span></li>
                </ul>
                <div class="nf-actions snippet-actions">
                    <a class="nf-button nf-button-primary nf-button-block" href="@($"/editor/{snippet.Id}")">
                        <Icon Name="edit" /> Edit
                    </a>
                    <button type="button" class="nf-button nf-button-block" @onclick="CopyRawUrlAsync">
                        <Icon Name="copy" /> Copy raw URL
                    </button>
                    <button type="button" class="nf-button nf-button-danger nf-button-block" @onclick="DeleteAsync">
                        <Icon Name="trash" /> Delete
                    </button>
                </div>
            </div>
        </aside>
    </div>

    @if (!string.IsNullOrWhiteSpace(snippet.Docs))
    {
        <section class="nf-panel nf-section">
            <div class="nf-panel-header">
                <strong>Documentation</strong>
            </div>
            <div class="nf-panel-body nf-markdown">
                @((MarkupString)docsHtml)
            </div>
        </section>
    }
}
