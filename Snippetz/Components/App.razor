<ForgeHostPage Title="Snippetz" IconHref="img/Icon.png" AppStylesheet="@Assets["css/snippetz.css"]">
    <AdditionalHead>
        <link id="hljs-theme" rel="stylesheet" href="lib/highlight.js/styles/github.min.css" />
        @* After the link above and after the library's theme-init.js, so the highlight theme matches the stored scheme before first paint. *@
        <script src="@Assets["js/snippetz.js"]"></script>
    </AdditionalHead>
    <ChildContent>
        <Routes @rendermode="InteractiveServer" />
    </ChildContent>
    <AdditionalBody>
        <script src="lib/highlight.js/highlight.min.js"></script>
    </AdditionalBody>
</ForgeHostPage>
