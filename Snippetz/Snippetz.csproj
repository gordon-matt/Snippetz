		<ProjectReference Include="..\Snippetz.Data.Npgsql\Snippetz.Data.Npgsql.csproj" />
		<ProjectReference Include="..\Snippetz.Data.Sql\Snippetz.Data.Sql.csproj" />
		<ProjectReference Include="..\Snippetz.Data.Sqlite\Snippetz.Data.Sqlite.csproj" />
		<ProjectReference Include="..\Snippetz.Models\Snippetz.Models.csproj" />
		<ProjectReference Include="..\Snippetz.Services\Snippetz.Services.csproj" />
	</ItemGroup>
</Project>
