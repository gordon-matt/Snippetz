@{
    string siteName = Constants.ServerSettingDefaults.SiteName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link id="hljs-theme" rel="stylesheet" href="~/lib/highlight.js/styles/github.min.css" />
    <link rel="stylesheet" href="~/css/snippetz.css" />
    <script src="~/js/theme-init.js"></script>
</head>
<body>
    <div class="sz-auth-shell">
        <div class="sz-auth-card">
            <a class="sz-brand" href="/">
                <img src="~/favicon.svg" alt="" width="22" height="22" />
                <span>@siteName</span>
            </a>
            @RenderBody()
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
